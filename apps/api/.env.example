# Postgres connection string (docker-compose maps the container's 5432 to host 5433,
# to avoid colliding with any other local Postgres already listening on 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/leaddiscovery

# LLM provider (Groq free tier: https://console.groq.com — OpenAI-compatible API)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Optional: if you have a search API key (Serper.dev has a free trial), it gives
# much better discovery results than the free HTML fallback. Leave blank to use
# the built-in DuckDuckGo HTML fallback (no key required).
SERPER_API_KEY=

# How many candidate businesses to gather per search. Above 10, this costs
# one extra Serper API request per additional 10 (Serper's Places endpoint
# caps at 10 results per request; getting more means paginating). Higher
# values also mean more scrape+LLM calls per search, so slower searches and
# more Groq usage. Default 8 keeps demos fast; raise it for real usage.
DISCOVERY_MAX_CANDIDATES=8

# Country-code bias for Serper's Places search — helps disambiguate a bare
# city name that exists in multiple countries (e.g. "Cambridge" or
# "Birmingham" both have a UK and a US match). Only breaks ties for genuinely
# ambiguous names; doesn't override an already-unambiguous location like
# "Toronto" or "Australia". Defaults to "gb" — change if you're mostly
# searching elsewhere.
SERPER_COUNTRY_BIAS=gb

PORT=4000
